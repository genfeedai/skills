{
  "name": "openclaw-integration",
  "version": "1.0.0",
  "description": "Connect agents and workflows to Genfeed.ai through MCP or CLI",
  "author": "genfeedai",
  "license": "MIT",
  "triggers": [
    "genfeed mcp",
    "openclaw integration",
    "connect to Genfeed",
    "Genfeed platform tools",
    "create content with Genfeed",
